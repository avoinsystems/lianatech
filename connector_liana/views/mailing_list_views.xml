<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mailing_list_view_form_liana" model="ir.ui.view">
        <field name="name">mailing.list.form.liana</field>
        <field name="model">mailing.list</field>
        <field name="inherit_id" ref="mass_mailing.mailing_list_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_to_liana"
                        string="Export to Liana"
                        type="object"
                        class="btn btn-secondary"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <group string="Liana Mailer">
                    <field name="liana_backend_id"/>
                    <field name="liana_list_id" readonly="1"/>
                    <field name="liana_truncate" widget="boolean_toggle"/>
                    <field name="date_liana_export"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
