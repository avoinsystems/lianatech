<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_export_mailing_lists_to_liana" model="ir.cron">
            <field name="name">Liana: Export Mailing Lists</field>
            <field name="model_id" ref="connector_liana.model_liana_mailing_list"/>
            <field name="state">code</field>
            <field name="code">model._cron_export_all_to_liana()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_fetch_mailer_events" model="ir.cron">
            <field name="name">Liana: Fetch Mailer Events</field>
            <field name="model_id" ref="connector_liana.model_liana_mailer_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_mailer_events()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
